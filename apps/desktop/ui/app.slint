import { VerticalBox, HorizontalBox, ScrollView, AboutSlint } from "std-widgets.slint";
import { Theme, Action, Rule, SectionTitle } from "tokens.slint";
import { RelayList, RelayRow } from "relay-list.slint";
import { Connections, ProfileRow, Setup } from "pages.slint";
import { Settings } from "settings.slint";
import { Home } from "home.slint";
export { RelayRow, ProfileRow }

export component AppWindow inherits Window {
    title: "vmate";
    no-frame: false;
    icon: @image-url("../assets/vmate.svg");
    preferred-width: 1160px; preferred-height: 770px;
    min-width: 480px; min-height: 600px;
    background: Theme.paper;
    default-font-size: 14px;
    in-out property <int> page: 6;
    in-out property <int> selected: -1;
    in-out property <string> query;
    callback filter-relays;
    changed query => { root.selected = -1; root.filter-relays(); }
    in property <bool> mac: false;
    in property <bool> fixture: false;
    in property <bool> busy: false;
    in property <bool> connected: false;
    in property <int> completed;
    in property <int> total;
    in property <[RelayRow]> relays;
    in property <[ProfileRow]> profiles;
    in property <string> status: "Not connected";
    in property <string> message: "Ready when you are. Your system network is unchanged.";
    in property <string> diagnostic;
    in property <string> openvpn;
    in property <string> service;
    in property <string> install-command;
    in property <string> activity;
    in property <bool> review-scroll: false;
    in-out property <string> workers: "64";
    in-out property <string> timeout: "5";
    in-out property <bool> reduced: false;
    in-out property <bool> lookup: false;
    in-out property <bool> auto-reconnect: false;
    in-out property <string> retry-limit: "3";
    in property <[string]> preset-names;
    in-out property <int> editing-preset;
    in-out property <int> scan-index;
    in-out property <int> connect-index;
    in-out property <string> preset-name: "Default";
    callback select-preset(int);
    callback auto-connect;
    callback scan;
    callback cancel;
    callback refresh;
    callback connect-profile(int);
    callback import-relay;
    callback export-relay;
    callback save;
    callback copy-command;
    callback quit;
    in-out property <bool> tray-enabled: false;
    in property <bool> tray-active: false;
    changed reduced => { Theme.reduced-motion = root.reduced; }
    VerticalBox { x: 0px; y: 0px; width: parent.width; height: parent.height; spacing: 0px; padding: 0px;
        if root.fixture: Rectangle { height: 26px; background: #f0e6cb;
            Text { text: "DESIGN REVIEW FIXTURE · No live network operation"; color: #654b1d; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
        }
        HorizontalBox { spacing: 0px;
            if root.width >= 760px: Rectangle { width: 160px; background: #eef0e9;
                VerticalBox { padding: 14px; spacing: 9px;
                    HorizontalBox { height: 66px; spacing: 9px;
                        Rectangle { width: 30px;
                            Image { source: @image-url("../assets/vmate.svg"); width: 30px; height: 30px; y: (parent.height - self.height) / 2; }
                        }
                        Text { text: "vmate"; font-size: 24px; font-weight: 700; color: Theme.ink; vertical-alignment: center; }
                    }
                    for label[index] in ["Home", "Relays", "Connections", "Activity", "Settings"]: Rectangle {
                        height: 43px; border-radius: 5px;
                        background: root.page == (index == 0 ? 6 : index == 1 ? 0 : index == 2 ? 1 : index) ? #dce5dc : nav.has-hover ? #e4e9e1 : transparent;
                        Text { x: 12px; text: label; vertical-alignment: center; height: parent.height; color: root.page == (index == 0 ? 6 : index == 1 ? 0 : index == 2 ? 1 : index) ? Theme.pine : Theme.muted; font-size: 14px; font-weight: root.page == (index == 0 ? 6 : index == 1 ? 0 : index == 2 ? 1 : index) ? 600 : 400; }
                        focus := FocusScope {
                            key-pressed(e) => { if e.text == "\n" || e.text == " " { root.page = index == 0 ? 6 : index == 1 ? 0 : index == 2 ? 1 : index; return accept; } return reject; }
                        }
                        border-width: focus.has-focus ? 2px : 0px;
                        border-color: Theme.pine;
                        nav := TouchArea { mouse-cursor: pointer; clicked => { focus.focus(); root.page = index == 0 ? 6 : index == 1 ? 0 : index == 2 ? 1 : index; } }
                    }
                    Rectangle { vertical-stretch: 1; }
                    Rule {}
                    Action { label: "About / help"; clicked => { root.page = 5; } }
                    Action { label: "Quit vmate"; clicked => { root.quit(); } }
                    Text { text: "DESKTOP PREVIEW / 1.2.4"; color: Theme.muted; font-size: 10px; }
                }
            }
            VerticalBox { padding: 0px; spacing: 0px;
                if root.diagnostic != "": Rectangle { height: 100px; background: #f7e8dd;
                    ScrollView { content-width: self.width - 12px; VerticalBox { padding: 12px; spacing: 6px;
                        Text { text: "Couldn’t finish"; color: #773b21; font-weight: 600; font-size: 14px; }
                        Text { text: root.diagnostic; color: #773b21; font-size: 13px; wrap: word-wrap; }
                    } }
                }
                if root.page == 6: Home { compact: root.width < 760px;
                    busy: root.busy; connected: root.connected; status: root.status;
                    completed: root.completed; total: root.total;
                    stopping: root.message == "Disconnecting and reaping owned processes…";
                    connect => { root.auto-connect(); } cancel => { root.cancel(); }
                }
                if root.page == 0: RelayList { review-scroll: root.review-scroll; query <=> root.query; rows: root.relays; selected <=> root.selected; busy: root.busy && root.status == "Scanning"; operation-blocked: root.busy;
                    completed: root.completed; total: root.total;
                    scan => { root.scan(); } cancel => { root.cancel(); }
                    import-relay => { root.import-relay(); } export-relay => { root.export-relay(); }
                }
                if root.page == 1: Connections { profiles: root.profiles; busy: root.busy; connected: root.connected;
                    mac: root.mac; status: root.status; message: root.message;
                    connect-profile(index) => { root.connect-profile(index); }
                    cancel => { root.cancel(); } refresh => { root.refresh(); } setup => { root.page = 2; }
                }
                if root.page == 2: Setup { busy: root.busy; browse-relays => { root.page = 0; } review-scroll: root.review-scroll; openvpn: root.openvpn; service: root.service; mac: root.mac;
                    install-command: root.install-command;
                    refresh => { root.refresh(); } copy-command => { root.copy-command(); }
                }
                if root.page == 3: Rectangle { background: Theme.paper;
                    VerticalBox { padding: 28px; spacing: 18px;
                        Text { text: "Activity"; font-size: 27px; font-weight: 600; color: Theme.ink; }
                        Text { text: "Latest events"; color: Theme.muted; font-size: 14px; wrap: word-wrap; }
                        Rule {}
                        ScrollView { content-width: self.width - 12px; VerticalBox { padding: 0px; alignment: start;
                            Text { text: root.activity == "" ? "No activity yet. Start a scan or check your setup." : root.activity;
                                color: Theme.ink; font-size: 13px; font-family: "monospace"; wrap: word-wrap;
                                horizontal-alignment: left; vertical-alignment: top; vertical-stretch: 0;
                            }
                            Rectangle { vertical-stretch: 1; }
                        } }
                    }
                }
                if root.page == 5: Rectangle { background: Theme.paper;
                    ScrollView { content-width: self.width - 12px; VerticalBox { padding: 28px; spacing: 20px;
                        Text { text: "vmate desktop"; color: Theme.ink; font-size: 27px; font-weight: 600; }
                        Text { text: "1.2.4 · desktop preview branch"; color: Theme.muted; font-size: 14px; }
                        Rule {}
                        Text { text: "Built with Rust and Slint."; color: Theme.ink; font-size: 15px; wrap: word-wrap; }
                        Text { text: "vmate source: MIT. Slint: Royalty-free Desktop, Mobile, and Web Applications License 2.0. Bundled OpenVPN and shared libraries retain their own terms. License notices ship with installation packages."; color: Theme.muted; font-size: 13px; wrap: word-wrap; }
                        HorizontalBox { AboutSlint { height: 130px; max-width: 300px; } Rectangle { horizontal-stretch: 1; } }
                        Text { text: "No analytics are collected by this frontend. Relay-country lookup is an explicit preference; enabling it sends relay IPs to ipinfo.io. Public VPN relays are third parties: a handshake is not a privacy guarantee."; color: Theme.muted; font-size: 13px; wrap: word-wrap; }
                        Rectangle { vertical-stretch: 1; }
                    }
                } }
                if root.page == 4: Settings { mac: root.mac; tray-enabled <=> root.tray-enabled; tray-active: root.tray-active; review-scroll: root.review-scroll;
                    names: root.preset-names; editing <=> root.editing-preset;
                    name <=> root.preset-name; scan-index <=> root.scan-index; connect-index <=> root.connect-index;
                    select-preset(index) => { root.select-preset(index); } auto-reconnect <=> root.auto-reconnect; retry-limit <=> root.retry-limit; busy: root.busy; workers <=> root.workers; timeout <=> root.timeout; reduced <=> root.reduced; lookup <=> root.lookup; save => { root.save(); } }
                Rule {}

            }
        }
        if root.width < 760px: HorizontalBox { padding: 12px; spacing: 12px;
            Action { label: "Home"; primary: root.page == 6; clicked => { root.page = 6; } }
            Action { label: "Relays"; primary: root.page == 0; clicked => { root.page = 0; } }
            Action { label: "About"; clicked => { root.page = 5; } }
            Action { label: "Settings"; primary: root.page == 4; clicked => { root.page = 4; } }
        }
    }
}
