import { VerticalBox, HorizontalBox, LineEdit, CheckBox, ComboBox, ScrollView } from "std-widgets.slint";
import { Theme, Action, Rule } from "tokens.slint";

export component Settings inherits Rectangle {
    in property <bool> busy;
    in property <bool> mac;
    in property <bool> tray-active;
    in-out property <bool> tray-enabled;
    in property <bool> review-scroll;
    in property <[string]> names;
    in-out property <int> editing;
    in-out property <int> scan-index;
    in-out property <int> connect-index;
    in-out property <string> name;
    in-out property <string> workers;
    in-out property <string> timeout;
    in-out property <string> retry-limit;
    in-out property <bool> auto-reconnect;
    in-out property <bool> reduced;
    in-out property <bool> lookup;
    callback select-preset(int);
    callback save;
    background: Theme.paper;
    VerticalBox { padding: 0px; spacing: 0px;
    ScrollView { content-y: root.review-scroll ? min(0px, self.height - self.content-height) : 0px; content-width: self.width - 12px;
        VerticalBox { padding: 24px; spacing: 16px;
            Text { text: "Settings"; color: Theme.ink; font-size: 24px; font-weight: 600; }
            Text { text: "Scan presets"; color: Theme.ink; font-size: 16px; font-weight: 600; }
            ComboBox { model: root.names; current-index <=> root.editing; selected(index) => { root.select-preset(self.current-index); } }
            LineEdit { text <=> root.name; placeholder-text: "Preset name · change to create a new preset"; }
            HorizontalBox { spacing: 16px;
                VerticalBox { spacing: 6px; Text { text: "Workers · 1–500"; color: Theme.muted; } LineEdit { text <=> root.workers; input-type: number; } }
                VerticalBox { spacing: 6px; Text { text: "Timeout · 1–120 s"; color: Theme.muted; } LineEdit { text <=> root.timeout; input-type: number; } }
            }
            Rule {}
            Text { text: "Action assignments"; color: Theme.ink; font-size: 16px; font-weight: 600; }
            HorizontalBox { spacing: 16px;
                VerticalBox { spacing: 6px; Text { text: "Scan"; color: Theme.muted; } ComboBox { model: root.names; current-index <=> root.scan-index; } }
                VerticalBox { spacing: 6px; Text { text: "Connect"; color: Theme.muted; } ComboBox { model: root.names; current-index <=> root.connect-index; } }
            }
            Text { text: "Save a new preset before assigning it."; color: Theme.muted; font-size: 12px; }
            Rule {}
            CheckBox { text: "Auto-reconnect"; checked <=> root.auto-reconnect; }
            HorizontalBox { spacing: 16px;
                Text { text: "Rescan loop limit · 1–20"; color: Theme.ink; vertical-alignment: center; }
                LineEdit { text <=> root.retry-limit; input-type: number; max-width: 90px; }
            }
            if !root.mac: CheckBox { text: "Show system tray icon · close window to tray"; checked <=> root.tray-enabled; }
            if !root.mac: Text { text: root.tray-active ? "Tray ready. Use its menu to reopen or quit vmate." : "Requires a desktop StatusNotifier/AppIndicator host. Without one, closing exits."; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
            CheckBox { text: "Reduce motion"; checked <=> root.reduced; }
            CheckBox { text: "Look up relay countries with ipinfo.io"; checked <=> root.lookup; }
            Text { text: "Country lookup sends relay IPs to ipinfo.io."; color: Theme.muted; font-size: 12px; wrap: word-wrap; }

        }
    }
    HorizontalBox { padding: 20px; Action { label: "Save settings"; primary: true; enabled: !root.busy; clicked => { root.save(); } } Rectangle { horizontal-stretch: 1; } }
    }
}
