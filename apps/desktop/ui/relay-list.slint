import { VerticalBox, HorizontalBox, LineEdit, ScrollView } from "std-widgets.slint";
import { Theme, Action, Rule, SectionTitle } from "tokens.slint";
export struct RelayRow { name: string, country: string, checked: string, path: string }

export component RelayList inherits Rectangle {
    in property <[RelayRow]> rows;
    in property <bool> review-scroll: false;
    in-out property <int> selected: -1;
    in property <bool> busy;
    in-out property <string> query;
    in property <int> completed;
    in property <int> total;
    callback scan;
    callback cancel;
    callback import-relay;
    callback export-relay;
    background: Theme.paper;
    VerticalBox { x: 0px; y: 0px; width: parent.width; height: parent.height; padding: 28px; spacing: 20px;
        HorizontalBox { spacing: 12px;
            VerticalBox { spacing: 5px;
                Text { text: "Find your next connection"; color: Theme.ink; font-size: 27px; font-weight: 600; }
                Text { text: "Test relays without changing your system network."; color: Theme.muted; font-size: 14px; }
            }
            Action { label: root.busy ? "Stop scan" : "Scan relays"; primary: true;
                clicked => { if root.busy { root.cancel(); } else { root.scan(); } }
            }
        }
        Rectangle { height: 42px; background: Theme.tint; border-radius: 4px;
            HorizontalBox { padding: 12px;
                Text { text: root.busy ? "Checking " + root.completed + " of " + root.total + " configurations" : "VPN Gate · UDP · " + root.rows.length + " saved handshakes"; color: Theme.pine; font-size: 13px; }
                Text { text: "A handshake is not a VPN connection"; color: Theme.muted; font-size: 12px; horizontal-alignment: right; }
            }
        }
        LineEdit { text <=> root.query; placeholder-text: "Filter by hostname or country"; height: 36px; }
        HorizontalBox { spacing: 22px;
            VerticalBox { spacing: 0px;
                HorizontalBox { height: 30px; Text { text: "RELAY"; font-size: 11px; color: Theme.muted; } Text { text: "REGION"; font-size: 11px; color: Theme.muted; horizontal-alignment: right; } }
                Rule {}
                if root.rows.length == 0: VerticalBox { alignment: center; spacing: 12px;
                    Text { text: root.query == "" ? "Your relay library starts here" : "No relays match this filter"; font-size: 21px; color: Theme.ink; font-weight: 600; }
                    Text { text: root.query == "" ? "Run a scan to check the built-in relays. Successful\nhandshakes are saved locally for next time." : "Try a different hostname or country code,\nor clear the filter to see all saved relays."; font-size: 14px; color: Theme.muted; wrap: word-wrap; }
                    Rectangle { vertical-stretch: 1; }
                }
                if root.rows.length > 0: ScrollView {
                    VerticalBox { spacing: 0px; padding: 0px;
                        for row[index] in root.rows: Rectangle { height: 73px; background: root.selected == index ? Theme.tint : hit.has-hover ? #f0f2ec : Theme.paper;
                            HorizontalBox { padding-left: 12px; padding-right: 12px; spacing: 12px;
                                VerticalBox { alignment: center; spacing: 5px;
                                    Text { text: row.name; color: Theme.ink; font-size: 14px; font-weight: 600; overflow: elide; }
                                    Text { text: row.checked; color: Theme.muted; font-size: 12px; overflow: elide; }
                                }
                                Text { text: row.country == "UNKNOWN" ? "Not looked up" : row.country; color: Theme.muted; font-size: 12px; vertical-alignment: center; horizontal-alignment: right; max-width: 100px; }
                            }
                            Rectangle { y: parent.height - 1px; height: 1px; width: parent.width; background: Theme.rule; }
                            focus := FocusScope {
                                key-pressed(e) => { if e.text == "\n" || e.text == " " { root.selected = index; return accept; } return reject; }
                            }
                            border-width: focus.has-focus ? 2px : 0px;
                            border-color: Theme.pine;
                            hit := TouchArea { mouse-cursor: pointer; clicked => { focus.focus(); root.selected = index; } }
                        }
                    }
                }
            }
            if root.width > 850px: Rectangle { width: 260px; border-width: 1px; border-color: Theme.rule; background: Theme.surface; border-radius: 6px;
                VerticalBox { padding: 18px; spacing: 12px;
                    ScrollView { content-width: self.width - 12px; content-y: root.review-scroll ? min(0px, self.height - self.content-height) : 0px; VerticalBox { padding: 0px; spacing: 12px; alignment: start;
                    SectionTitle { text: "RELAY DETAILS"; }
                    Text { text: root.selected >= 0 ? root.rows[root.selected].name : "Choose a relay"; font-size: 19px; font-weight: 600; color: Theme.ink; wrap: char-wrap; }
                    Text { text: root.selected >= 0 ? "Handshake passed. Import this config into your system VPN service to connect." : "Select a saved handshake to inspect, export or import its OpenVPN configuration."; font-size: 14px; color: Theme.muted; wrap: word-wrap; }
                    Rule {}
                    SectionTitle { text: "LOCAL CONFIGURATION"; }
                    Text { text: root.selected >= 0 ? root.rows[root.selected].path : "No relay selected"; color: Theme.muted; font-size: 12px; wrap: char-wrap; }
                    Rectangle { vertical-stretch: 1; }
                    } }
                    Action { label: "Import into system VPN"; primary: true; enabled: root.selected >= 0 && !root.busy; clicked => { root.import-relay(); } }
                    Action { label: "Export configuration…"; enabled: root.selected >= 0; clicked => { root.export-relay(); } }
                }
            }
        }
        if root.width <= 850px: HorizontalBox { spacing: 12px;
            Action { label: "Import selected relay"; enabled: root.selected >= 0 && !root.busy; clicked => { root.import-relay(); } }
            Action { label: "Export configuration…"; enabled: root.selected >= 0; clicked => { root.export-relay(); } }
        }
    }
}
